{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": "Prometheus",
      "description": "Per-job success flag reported to the pushgateway (1 = ok, 0 = fail).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "OK", "color": "green", "index": 0 },
                "0": { "text": "FAIL", "color": "red", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "${use_case}_job_last_success{use_case=\"$use_case\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "Pipeline Success",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Seconds since each pipeline batch job last reported to the pushgateway.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1800 },
              { "color": "red", "value": 3600 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "time() - ${use_case}_job_last_run_timestamp{use_case=\"$use_case\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "Job Freshness",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Count of pipeline batch jobs whose last exit code was non-zero.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "count(${use_case}_job_last_exit_code{use_case=\"$use_case\"} != 0)",
          "legendFormat": "Failed Jobs",
          "refId": "A"
        }
      ],
      "title": "Failed Jobs",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Total consumer lag across all Kafka consumer groups and topics.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 5000 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(kafka_consumergroup_lag)",
          "legendFormat": "Total Lag",
          "refId": "A"
        }
      ],
      "title": "Kafka Lag Total",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Duration of the last run of each pipeline batch job.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 1
          },
          "mappings": [],
          "unit": "s"
        }
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "${use_case}_job_last_duration_seconds{use_case=\"$use_case\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "Pipeline Duration",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Consumer lag broken down by Kafka topic.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" }
          },
          "mappings": []
        }
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (topic) (kafka_consumergroup_lag)",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "title": "Kafka Consumer Lag by Topic",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Container restart counts for pods in the use-case namespace.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" }
          },
          "mappings": []
        }
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 16 },
      "id": 7,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "kube_pod_container_status_restarts_total{namespace=\"use-case-$use_case\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Ingestion/Processing Pod Restarts",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Available replica count per deployment in the use-case namespace.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" }
          },
          "mappings": []
        }
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 16 },
      "id": 8,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"use-case-$use_case\"}",
          "legendFormat": "{{deployment}}",
          "refId": "A"
        }
      ],
      "title": "Available Replicas",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["dataops", "etl", "pipeline"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "crypto", "value": "crypto" },
        "hide": 0,
        "label": "Use case",
        "name": "use_case",
        "options": [ { "selected": true, "text": "crypto", "value": "crypto" } ],
        "query": "crypto",
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "DataOps Pipeline Monitoring",
  "uid": "dataops-pipeline",
  "version": 1
}

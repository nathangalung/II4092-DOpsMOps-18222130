        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "100 * kubelet_volume_stats_used_bytes{namespace=\"storage\"} / kubelet_volume_stats_capacity_bytes{namespace=\"storage\"}",

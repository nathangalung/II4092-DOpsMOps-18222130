    {
      "datasource": "Prometheus",
      "description": "Total working-set memory across ClickHouse (chi-*) pods.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {"group": "A", "mode": "none"}
          },
          "mappings": [],
          "unit": "bytes"
        }
      },
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"storage\",pod=~\"chi-.*\"})",
          "legendFormat": "ClickHouse",
          "refId": "A"

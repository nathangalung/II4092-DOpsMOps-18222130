# =============================================================================
# experiments/config.crypto.env — evaluation scenario inputs (crypto use case)
# =============================================================================
# The SINGLE swap point for the evaluation harness. Every k6 script reads these
# as `__ENV.*`, the drift injector as `os.environ`, and the chaos manifests are
# rendered from them with `envsubst`. Nothing under experiments/ hardcodes a
# domain string without also honouring the matching variable here.
#
# Out of the box this file supplies the crypto values, so the thesis use case
# runs with no edits. To evaluate a DIFFERENT use case, copy this file and edit
# only the DOMAIN block — change only the config, never the scripts:
#
#     cp experiments/config.crypto.env experiments/config.fraud.env
#     $EDITOR experiments/config.fraud.env            # edit DOMAIN values
#     export EXPERIMENTS_CONFIG=experiments/config.fraud.env
#
# Load it into the environment before running any scenario (exports every KEY):
#
#     set -a; . "${EXPERIMENTS_CONFIG:-experiments/config.crypto.env}"; set +a
#
# Then run k6 / uv / envsubst as documented in README.md.
#
# NOTE — the DOMAIN values below MIRROR canonical declarations that live in
# use-case-crypto/ (the Kafka topic in pipeline-config; the feature service +
# entity in the Feast feature-repo ConfigMap
# manifests/base/configmaps/feast.yaml; the Qdrant collection in
# manifests/base/cronjobs/vector-embedding.yaml VECTOR_COLLECTION; the predictor
# InferenceService name). They are duplicated here on purpose: this harness is a
# manual, read-only client and must not couple to live cluster state.
# `make usecase-configure` rebrands the use-case-crypto/ tree only — it does NOT
# rewrite this sibling file, so if you change the use-case prefix there, mirror
# the DOMAIN values here by hand.
# =============================================================================

# --- DOMAIN — the per-use-case swap surface ---------------------------------
export SYMBOLS="BTC-USD,ETH-USD,SOL-USD"             # entity instances to sample
export ENTITY_KEY="symbol"                           # Feast entity join key
export FEATURE_SERVICE="crypto_inference_features"   # Feast feature service name
export COLLECTION="crypto_sentiment"                 # Qdrant collection (embeddings)
export VECTOR_DIM="768"                              # embedding dimensionality
export DRIFT_TOPIC="crypto.validated"                # Kafka topic the injector perturbs
export PRICE_FIELDS="open,high,low,close,vwap"       # numeric fields the injector shifts
export PREDICTOR_NAME="crypto-predictor"             # KServe InferenceService name
export USE_CASE_NAMESPACE="use-case-crypto"          # deployed use-case namespace
export GATEWAY_APP="gateway"                          # gateway app label (chaos target)
export ML_BRIDGE_APP="ml-bridge"                      # ml-bridge online-feature reader — chaos kill target + mlflow-latency source (replaced retired feature-cache)
# Medallion tables the data-engineer ETL "did data land?" check (experiments/etl/)
# inspects and the offline-parity leg of the feast check reads. Names mirror
# use-case-crypto/database/init_clickhouse.sql + the dbt models (staging/ → silver,
# marts/ → gold). NEVER point a check at a *_kafka table: those are ENGINE=Kafka
# and SELECTing them consumes Kafka offsets, silently dropping live records from
# the running pipeline (see the warning in experiments/etl/README.md).
export BRONZE_LANDING_TABLE="bronze.crypto_ohlcv"     # raw landing (MergeTree target of the _consumer MV)
export SILVER_STAGING_TABLE="silver.stg_ohlcv"        # dbt staging model
export GOLD_FEATURES_TABLE="gold.fct_ohlcv_features"  # dbt features mart
export GOLD_TRAINING_TABLE="gold.fct_training_data"   # dbt point-in-time training mart
export EVENT_TIME_COLUMN="timestamp"                  # event-time column on the landing table (freshness probe)
# Batch↔stream parity oracle (experiments/parity/, KF-11/SK-F-11): the stream
# table is the MergeTree the Flink-fed _features_kafka MV writes into; the
# columns are the SAME trailing 20-event volume mean computed by both paths
# (Flink Indicators.rollingMean ↔ dbt avg(volume) OVER w20). The thresholds are
# scenario knobs, not domain names — tighten/loosen per evaluation run.
export PARITY_STREAM_TABLE="bronze.crypto_ohlcv_features"  # Flink speed-layer features (MergeTree)
export PARITY_STREAM_COLUMN="secondary_avg"                # stream volume SMA (FLINK_SECONDARY_AVG_PERIOD=20)
export PARITY_BATCH_TABLE="${GOLD_FEATURES_TABLE}"         # dbt features mart
export PARITY_BATCH_COLUMN="volume_sma_20"                 # batch volume SMA (w20)
export PARITY_LOOKBACK_HOURS="24"                          # comparison window
export PARITY_REL_TOLERANCE="0.000001"                     # float-noise budget (relative)
export PARITY_ABS_TOLERANCE="0.000001"                     # float-noise budget (absolute, near-zero values)
export PARITY_MIN_MATCH_RATE="0.99"                        # KF-11 pass criterion
# OpenLineage namespace the use-case's OWN jobs emit under (the lakehouse DAG's
# manual emit + the dbt provider): "<use-case>-pipeline". Domain-derived, so it
# lives here in the DOMAIN block — the KF-08 lineage walk searches it alongside
# the platform-stable provider namespace (OPENLINEAGE_NAMESPACE_PROVIDER below).
export OPENLINEAGE_NAMESPACE_PIPELINE="crypto-pipeline"

# --- ENDPOINTS — platform service URLs (namespace-stable defaults) ----------
# These point at platform components and rarely change; override only if your
# cluster exposes them elsewhere. PREDICT_URL is composed from the DOMAIN names
# above so a predictor rename flows automatically.
export FEAST_URL="http://feast.model-lifecycle.svc:6566"
export QDRANT_URL="http://qdrant.storage.svc:6333"
export PREDICT_URL="http://${PREDICTOR_NAME}.${USE_CASE_NAMESPACE}.svc/v2/models/${PREDICTOR_NAME}/infer"
# ClickHouse — offline store / medallion warehouse (the platform CHI named
# `platform` in the `storage` ns; native protocol :9000, HTTP :8123). The ETL
# data-landed check and the feast offline-parity leg connect here by running
# `clickhouse-client` inside the CHI pod (kubectl exec), so they need the ns.
export CLICKHOUSE_HOST="clickhouse-platform.storage.svc.cluster.local"
export CLICKHOUSE_NAMESPACE="storage"
export CLICKHOUSE_CHI="platform"          # CHI name → pod label clickhouse.altinity.com/chi
# DataHub GMS — lineage graph the KF-08 walk queries (GraphQL at /api/graphql;
# OpenLineage ingest at /openapi/openlineage). Platform component, ns-stable.
export DATAHUB_GMS_URL="http://datahub-gms.data-governance.svc.cluster.local:8080"
# OpenLineage namespaces the lineage graph is keyed by. The Airflow provider
# transport emits under "default" (platform airflow ConfigMap OPENLINEAGE_NAMESPACE);
# the lakehouse DAG's manual emit + the dbt provider emit under "<use-case>-pipeline".
# The KF-08 walk must search BOTH or the graph looks fragmented — see
# experiments/lineage/README.md.
export OPENLINEAGE_NAMESPACE_PROVIDER="default"
export OPENLINEAGE_NAMESPACE_PIPELINE="crypto-pipeline"

# --- KAFKA — drift injector connection --------------------------------------
# SCRAM credentials are runtime secrets — do NOT commit them. Fetch live, e.g.:
#   export KAFKA_USER=...     KAFKA_PASSWORD="$(kubectl -n data-ingestion \
#     get secret <kafka-user> -o jsonpath='{.data.password}' | base64 -d)"
export KAFKA_BOOTSTRAP="platform-kafka-kafka-bootstrap.data-ingestion.svc.cluster.local:9093"
export KAFKA_SECURITY_PROTOCOL="SASL_SSL"
export KAFKA_SASL_MECHANISM="SCRAM-SHA-512"
# export KAFKA_USER=""
# export KAFKA_PASSWORD=""
# export KAFKA_CA="/etc/kafka/ca.crt"

# --- TUNING — load knobs (not domain-specific) ------------------------------
export QPS="5000"        # feast-online-latency constant arrival rate (req/s)
export RPS="100"         # vector-search constant arrival rate (req/s)
export DURATION="15m"    # latency-test sustained duration

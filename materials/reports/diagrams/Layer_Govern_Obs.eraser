// Layer_Govern_Obs — Governance and Observability Layer
// Render manual: https://app.eraser.io > Diagram-as-code (cloud architecture)
// Ekspor PNG ke materials/reports/figures/Layer_Govern_Obs.png
// Acuan: Subbab IV.2.4 (subsec:lapisan-tata-kelola); rincian Layer 7 dari Gambar IV.1.
// Fokus: katalog, lineage, dan kualitas data berdampingan dengan tiga pilar
// observabilitas pada satu antarmuka Grafana, plus dashboard BI Superset.
// Landasan layer: label grup membawa kategori sumbernya, yaitu komponen
// monitoring yang dipisah dari kategori inference (najafabadi2024analysis)
// ditambah tata kelola data DataOps (munappy2020adhoc); penataan ulang
// dinyatakan pada prosa IV.2.

direction right

// Penghasil sinyal (batas)
Workload Layer [icon: layers, color: gray, label: "Workload Layer (data, feature, model)"]

// Governance and Observability Layer
Governance and Observability Layer [icon: eye, color: teal, label: "Governance and Observability Layer (monitoring + DataOps governance)"] {
  Tata Kelola Data [icon: book] {
    DataHub [icon: book-open, label: "DataHub (katalog metadata)"]
    OpenLineage [icon: git-merge, label: "OpenLineage (lineage)"]
    Great Expectations [icon: check-square, label: "Great Expectations (kualitas)"]
    Evidently [icon: activity, label: "Evidently (deteksi drift)"]
  }
  Observabilitas [icon: monitor] {
    OpenTelemetry [icon: radio, label: "OpenTelemetry Collector"]
    Prometheus [icon: prometheus, label: "Prometheus + Pushgateway + Sloth"]
    Loki [icon: file-text, label: "Loki (log)"]
    Tempo [icon: clock, label: "Tempo (trace)"]
    Pyroscope [icon: flame, label: "Pyroscope (profil)"]
    Grafana [icon: grafana, label: "Grafana (dashboard operasional)"]
    OpenCost [icon: dollar-sign, label: "OpenCost (biaya)"]
  }
  Superset [icon: pie-chart, label: "Apache Superset (dashboard BI)"]
}

// Indeks dan konsumen (batas)
OpenSearch [icon: search, color: green, label: "OpenSearch (indeks pencarian)"]
Business User [icon: user, color: gray]

// Alur tata kelola dan lineage
Workload Layer > OpenLineage: emisi lineage
OpenLineage > DataHub: graf lineage
Great Expectations > DataHub: hasil validasi
Workload Layer > Great Expectations: kontrak kualitas
Workload Layer > Evidently: distribusi fitur
DataHub -- OpenSearch: indeks pencarian

// Alur observabilitas
Workload Layer > OpenTelemetry: metrik + log + trace
OpenTelemetry > Tempo: trace
OpenTelemetry > Prometheus: metrik
OpenTelemetry > Loki: log
Prometheus > Grafana
Loki > Grafana
Tempo > Grafana
Pyroscope > Grafana: profil
Prometheus > OpenCost: metrik biaya
OpenCost > Grafana: biaya per beban

// Alur BI
DataHub > Superset: dashboard BI
Business User > Superset: analitik
Business User > Grafana: pemantauan

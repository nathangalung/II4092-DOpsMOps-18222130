// Layer_Model — Model Lifecycle Layer dan Model Serving Layer
// Render manual: https://app.eraser.io > Diagram-as-code (cloud architecture)
// Ekspor PNG ke materials/reports/figures/Layer_Model.png
// Acuan: Subbab IV.2.3 (subsec:lapisan-model); rincian Layer 5-6 dari Gambar IV.1.
// Fokus: eksperimen, training, registri, dan model serving dengan promosi
// bertahap serta pemicu retraining otomatis.
// Landasan layer: label grup membawa kategori sumbernya (najafabadi2024analysis)
// yaitu ML training + model registry + ML metadata (storage and versioning)
// dan inference; penataan ulang dinyatakan pada prosa IV.2.

direction right

// Sumber fitur (batas)
Layanan Fitur [icon: package, color: green, label: "Layanan Fitur (Feast, Valkey, Qdrant)"]

// Model Lifecycle Layer
Model Lifecycle Layer [icon: refresh-cw, color: purple, label: "Model Lifecycle Layer (ML training + model registry + ML metadata)"] {
  Kubeflow Notebooks [icon: book-open, label: "Kubeflow Notebooks"]
  Kubeflow Pipelines [icon: workflow, label: "Kubeflow Pipelines"]
  Katib [icon: sliders, label: "Katib (HPO)"]
  Kubeflow Trainer [icon: cpu, label: "Kubeflow Trainer"]
  MLflow [icon: package, label: "MLflow (tracking + registry)"]
  Argo Workflows [icon: workflow, label: "Argo Workflows (CronWorkflow)"]
}

// Model Serving Layer
Model Serving Layer [icon: send, color: red, label: "Model Serving Layer (inference)"] {
  KServe [icon: server, label: "KServe (runtime MLServer)"]
  Knative [icon: cloud, label: "Knative (serverless)"]
  Argo Rollouts [icon: trending-up, label: "Argo Rollouts (canary)"]
}

// Pemicu dan konsumen (batas)
Evidently [icon: activity, color: teal, label: "Evidently (sinyal drift)"]
Aplikasi Hilir [icon: monitor, color: gray]

// Alur eksperimen dan training
Layanan Fitur > Kubeflow Pipelines: fitur pelatihan
Kubeflow Notebooks > Kubeflow Pipelines: eksperimen ke pipeline
Kubeflow Pipelines <> Katib: HPO
Kubeflow Pipelines > Kubeflow Trainer: training job
Kubeflow Pipelines > MLflow: log run + registrasi model

// Alur serving dan promosi
MLflow > KServe: deploy dari registry
Layanan Fitur > KServe: online dan vector feature
KServe -- Knative: autoscaling serverless
Argo Rollouts -- KServe: promosi bertahap
Aplikasi Hilir > KServe: permintaan inferensi

// Alur retraining otomatis
Evidently > Argo Workflows: pemicu drift
Argo Workflows > Kubeflow Pipelines: retrain otomatis

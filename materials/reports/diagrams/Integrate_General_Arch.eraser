// Integrate_General_Arch — Arsitektur Terintegrasi Platform DataOps dan MLOps
// Render manual: https://app.eraser.io > Diagram-as-code (cloud architecture)
// Ekspor PNG ke materials/reports/figures/Integrate_General_Arch.png
// Acuan: Gambar IV.1 (fig:integrate-general); tujuh lapis Subbab IV.2;
// menjawab fragmentasi Gambar III.1 serta dua pemicu Bab I
// (beban integrasi/konfigurasi dan biaya lisensi berlangganan):
// satu bidang kendali Kubernetes, satu sumber kebenaran Git,
// seluruh komponen open source, kontrak antar lapis eksplisit.

direction right

// ===== Aktor =====
Pengguna [icon: users, color: gray] {
  Business User [icon: user]
  Data Engineer [icon: user]
  Data Scientist [icon: user]
  ML Engineer [icon: user]
}
Sumber Data Eksternal [icon: cloud, color: gray]
Aplikasi Hilir [icon: monitor, color: gray]

// ===== GitOps — satu sumber kebenaran =====
GitOps [icon: git-branch, color: blue] {
  Gitea [icon: git-merge, label: "Gitea (Git internal)"]
  Tekton [icon: settings, label: "Tekton (CI)"]
  Argo CD [icon: refresh-cw, label: "Argo CD (GitOps CD)"]
}

// ===== Lapis 1 — Infrastruktur =====
Lapisan Infrastruktur [icon: kubernetes, color: blue] {
  Kubernetes [icon: kubernetes, label: "Kubernetes (k3s)"]
  Istio [icon: network, label: "Istio (mesh + mTLS)"]
  APISIX [icon: globe, label: "APISIX (API gateway)"]
  Keamanan [icon: shield] {
    Dex [icon: key, label: "Dex (OIDC SSO)"]
    oauth2-proxy [icon: lock, label: "oauth2-proxy"]
    SpiceDB [icon: shield, label: "SpiceDB (otorisasi)"]
    OpenBao [icon: lock, label: "OpenBao (rahasia)"]
    ESO [icon: refresh-cw, label: "External Secrets Operator"]
    Kyverno [icon: check-circle, label: "Kyverno (policy)"]
    Falco [icon: eye, label: "Falco (runtime security)"]
    Trivy Operator [icon: search, label: "Trivy Operator (pemindaian)"]
  }
  Operasional [icon: settings] {
    cert-manager [icon: award, label: "cert-manager (TLS)"]
    Velero [icon: archive, label: "Velero (cadangan)"]
    Chaos Mesh [icon: zap, label: "Chaos Mesh (uji ketahanan)"]
    Autoscaler [icon: trending-up, label: "HPA + VPA + KEDA"]
    Kueue [icon: list, label: "Kueue (antrean job)"]
  }
}

// ===== Lapis 2 — Ingestasi Data =====
Lapisan Ingestasi Data [icon: download, color: orange] {
  Kafka Connect [icon: plug, label: "Kafka Connect + Debezium (CDC)"]
  Kafka [icon: kafka, label: "Apache Kafka (Strimzi)"]
  Karapace [icon: file-text, label: "Karapace (schema registry)"]
  Kafbat UI [icon: monitor, label: "Kafbat UI"]
}

// ===== Lapis 3 — Pemrosesan =====
Lapisan Pemrosesan [icon: cpu, color: yellow] {
  Flink [icon: zap, label: "Apache Flink (stream)"]
  Spark [icon: sun, label: "Apache Spark (batch)"]
  dbt [icon: code, label: "dbt (transformasi SQL)"]
  Airflow [icon: clock, label: "Apache Airflow (orkestrasi data)"]
  Trino [icon: search, label: "Trino (federasi kueri)"]
}

// ===== Lapis 4 — Penyimpanan dan Fitur =====
Lapisan Penyimpanan Fitur [icon: database, color: green] {
  Lakehouse [icon: layers] {
    MinIO [icon: hard-drive, label: "MinIO (objek + KES)"]
    lakeFS [icon: git-branch, label: "lakeFS (versi data)"]
    Iceberg [icon: layers, label: "Apache Iceberg (format tabel)"]
    Lakekeeper [icon: book, label: "Lakekeeper (katalog REST)"]
  }
  Basis Data [icon: database] {
    ClickHouse [icon: bar-chart, label: "ClickHouse (OLAP)"]
    PostgreSQL [icon: postgresql, label: "PostgreSQL (CNPG)"]
    MySQL [icon: mysql, label: "MySQL"]
    OpenSearch [icon: search, label: "OpenSearch (log + teks)"]
  }
  Layanan Fitur [icon: package] {
    Feast [icon: package, label: "Feast (feature store)"]
    Valkey [icon: zap, label: "Valkey (online store)"]
    Qdrant [icon: target, label: "Qdrant (indeks vektor)"]
  }
}

// ===== Lapis 5 — Siklus Hidup Model =====
Lapisan Siklus Hidup Model [icon: refresh-cw, color: purple] {
  Kubeflow Notebooks [icon: book-open, label: "Kubeflow Notebooks"]
  Kubeflow Pipelines [icon: workflow, label: "Kubeflow Pipelines"]
  Katib [icon: sliders, label: "Katib (HPO)"]
  Kubeflow Trainer [icon: cpu, label: "Kubeflow Trainer"]
  MLflow [icon: package, label: "MLflow (tracking + registry)"]
  Argo Workflows [icon: workflow, label: "Argo Workflows (CronWorkflow)"]
}

// ===== Lapis 6 — Penyajian Model =====
Lapisan Penyajian Model [icon: send, color: red] {
  KServe [icon: server, label: "KServe (runtime MLServer)"]
  Knative [icon: cloud, label: "Knative (serverless)"]
  Argo Rollouts [icon: trending-up, label: "Argo Rollouts (canary)"]
}

// ===== Lapis 7 — Tata Kelola dan Observabilitas =====
Lapisan Tata Kelola dan Observabilitas [icon: eye, color: teal] {
  Tata Kelola Data [icon: book] {
    DataHub [icon: book-open, label: "DataHub (katalog metadata)"]
    OpenLineage [icon: git-merge, label: "OpenLineage (lineage)"]
    Great Expectations [icon: check-square, label: "Great Expectations (kualitas)"]
    Evidently [icon: activity, label: "Evidently (deteksi drift)"]
  }
  Observabilitas [icon: monitor] {
    OpenTelemetry [icon: radio, label: "OpenTelemetry Collector"]
    Prometheus [icon: prometheus, label: "Prometheus + Pushgateway + Sloth"]
    Loki [icon: file-text, label: "Loki (log)"]
    Tempo [icon: clock, label: "Tempo (trace)"]
    Pyroscope [icon: flame, label: "Pyroscope (profil)"]
    Grafana [icon: grafana, label: "Grafana (dasbor operasional)"]
    OpenCost [icon: dollar-sign, label: "OpenCost (biaya)"]
  }
  Superset [icon: pie-chart, label: "Apache Superset (dasbor BI)"]
}

// ===== Alur akses pengguna =====
Business User > APISIX
Data Engineer > APISIX
Data Scientist > APISIX
ML Engineer > APISIX
APISIX > Dex: OIDC SSO tunggal
Dex > SpiceDB: otorisasi relasi
Aplikasi Hilir > APISIX: permintaan inferensi
APISIX > KServe: rute inferensi

// ===== Alur GitOps =====
Data Engineer > Gitea: commit konfigurasi
Gitea > Tekton: webhook CI
Tekton > Gitea: image + manifest baru
Gitea > Argo CD: pull manifest
Argo CD > Kubernetes: sinkronisasi deklaratif
OpenBao > ESO: distribusi rahasia

// ===== Alur data =====
Sumber Data Eksternal > Kafka Connect: REST + CDC
Kafka Connect > Kafka
Kafka <> Karapace: validasi skema
Kafka > Flink: jalur stream
Flink > ClickHouse: agregasi real-time
Kafka > Spark: jalur batch
Airflow > Spark: penjadwalan
Airflow > dbt: transformasi terjadwal
Spark > Iceberg: tulis tabel
Iceberg -- MinIO: penyimpanan objek
lakeFS -- MinIO: versi data
Lakekeeper -- Iceberg: katalog tabel
Trino > Iceberg: kueri federatif
dbt > ClickHouse: model gold

// ===== Alur fitur dan model =====
ClickHouse > Feast: sumber offline
Feast > Valkey: materialisasi online
Feast > Kubeflow Pipelines: fitur pelatihan
Kubeflow Notebooks > Kubeflow Pipelines: eksperimen ke pipeline
Kubeflow Pipelines <> Katib: HPO
Kubeflow Pipelines > Kubeflow Trainer: job pelatihan
Kubeflow Pipelines > MLflow: log run + registrasi model
MLflow > KServe: deploy dari registry
Valkey > KServe: fitur online
Qdrant > KServe: fitur vektor
KServe -- Knative: autoscaling serverless
Argo Rollouts -- KServe: promosi bertahap
Evidently > Argo Workflows: pemicu drift
Argo Workflows > Kubeflow Pipelines: retrain otomatis

// ===== Alur tata kelola dan observabilitas =====
Airflow > OpenLineage: emisi lineage
Spark > OpenLineage: emisi lineage
OpenLineage > DataHub: graf lineage
Great Expectations > DataHub: hasil validasi
OpenTelemetry > Tempo: trace
OpenTelemetry > Prometheus: metrik
OpenTelemetry > Loki: log
Prometheus > Grafana
Loki > Grafana
Tempo > Grafana
ClickHouse > Superset: dasbor BI
Trino > Superset: kueri ad-hoc

// ===== Keamanan dan kebijakan lintas-layer =====
Istio > oauth2-proxy: ext_authz
oauth2-proxy > Dex: OIDC
cert-manager > APISIX: sertifikat TLS
Kyverno > Kubernetes: kebijakan admisi
Falco -- Kubernetes: keamanan runtime
Trivy Operator -- Kubernetes: pemindaian kerentanan

// ===== Operasional dan keandalan =====
Chaos Mesh > Kubernetes: injeksi gangguan
Velero > MinIO: simpan cadangan
Prometheus > Autoscaler: sinyal metrik
Autoscaler > Kubernetes: skala replica
Kueue > Kubeflow Trainer: admisi kuota job

// ===== Penyimpan metadata dan pemantauan =====
Kafbat UI -- Kafka: pemantauan topik
Kubeflow Pipelines -- MySQL: metadata MLMD
MLflow -- PostgreSQL: backend metadata
DataHub -- OpenSearch: indeks pencarian
Pyroscope > Grafana: profil
Prometheus > OpenCost: metrik biaya

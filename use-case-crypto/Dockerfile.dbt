# dbt is pinned to Python 3.13 even though the rest of the platform now runs on
# 3.14.  Reason: dbt-common ≤ 1.x bundles mashumaro 3.x whose dataclass-unpacker
# code generator cannot resolve `Optional[str]` annotations under Python 3.14's
# PEP 749/757 deferred-evaluation rules.  Concretely the import chain
# `dbt-core → dbt-common → mashumaro.jsonschema.models.JSONObjectSchema`
# raises `UnserializableField: Field "schema" of type Optional[str] ... is not
# serializable` at import time on 3.14 (verified against dbt-core 1.10.x +
# dbt-clickhouse 1.10.0 + mashumaro 3.x on 2026-05).  dbt-labs has not yet
# published a 3.14-supported dbt-common; until they do this image stays on
# the 3.13 interpreter while still using uv for reproducible installs.
FROM ghcr.io/astral-sh/uv:python3.13-trixie-slim

WORKDIR /dbt

# `uv tool install` (NOT `uvx`): installs dbt as a PERSISTENT tool whose `dbt`
# console-script lands on PATH at /usr/local/bin/dbt. Every consumer invokes a
# real `dbt` command — the Airflow KubernetesPodOperator (cmds=["dbt"]) and the
# Tekton dbt-clickhouse-task (`dbt deps` / `dbt run`). The prior `uvx … dbt`
# ENTRYPOINT left NO `dbt` on PATH (uvx runs the tool ephemerally), so those
# bare-`dbt` invocations failed with "executable not found" and the gold dbt
# marts never materialised. uvx also cached its env under the build user's HOME
# (/root), unreachable by the runtime USER 1000 (HOME=/home/app) → a runtime
# re-resolve that breaks on an air-gapped node. Pinning UV_TOOL_DIR/CACHE to a
# world-readable /opt path + `uv tool install` makes the toolchain deterministic
# and offline-safe regardless of HOME.
ENV UV_TOOL_BIN_DIR=/usr/local/bin \
    UV_TOOL_DIR=/opt/uv/tools \
    UV_CACHE_DIR=/opt/uv/cache
RUN uv tool install "dbt-core" --with "dbt-clickhouse==1.10.0" \
    && dbt --version

# Copy project files
COPY dbt/dbt_project.yml dbt/profiles.yml ./
COPY dbt/packages.yml ./
COPY dbt/macros/ ./macros/
COPY dbt/models/ ./models/
COPY dbt/tests/ ./tests/

# Install dbt packages (dbt-utils for unique_combination_of_columns etc).
# `dbt` is now a real PATH command (uv tool install above), so no uvx wrapper.
RUN dbt deps --profiles-dir /dbt --project-dir /dbt

RUN useradd -u 1000 -m -s /usr/sbin/nologin app \
    && chown -R 1000:1000 /dbt /opt/uv

USER 1000:1000

# Real `dbt` on PATH — consumers may run it directly (cmds=["dbt"], `dbt run`).
ENTRYPOINT ["dbt"]
CMD ["run", "--profiles-dir", "/dbt", "--project-dir", "/dbt"]
